# Safe local-development examples only. Copy to your own untracked environment file.
DB_URL=jdbc:mysql://localhost:3306/adproject?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=adproject
DB_PASSWORD=replace-with-local-password
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-with-resend-api-key
SMTP_FROM_ADDRESS=no-reply@your-verified-domain.example
SMTP_STARTTLS=true
JWT_SECRET=replace-with-at-least-32-random-bytes
SERVER_PORT=8080
# Recruiter Google OAuth connection (Google Meet slice). Placeholders only — never commit real values.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-deployed-host/api/v1/recruiter/google-oauth/callback
# Fixed recruiter Web page used after the backend OAuth callback; replace with the exact active Web origin.
GOOGLE_OAUTH_WEB_RETURN_URI=http://localhost:5173/recruiter/google-oauth
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Spring Boot -> private Python recommendation service.
ML_ENABLED=true
ML_BASE_URL=http://127.0.0.1:8000
ML_INTERNAL_TOKEN=replace-with-a-shared-local-token
ML_CONNECT_TIMEOUT=2s
ML_READ_TIMEOUT=5s
ML_MAX_JOBS=500

# Used by the Python service when it is started from ml-service/.
ML_MODEL_PATH=artifacts/active/model.joblib

# Optional one-time grant for an existing registered account. Remove after the first successful startup.
ADMIN_BOOTSTRAP_EMAIL=

# Spring Boot -> private Python Agent planner.
AGENT_PLANNER_BASE_URL=http://localhost:8090
AGENT_PREVIEW_TTL_SECONDS=900

# Private Python Agent -> DeepSeek. Keep the real key only in an untracked local environment.
DEEPSEEK_API_KEY=replace-with-local-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=15
