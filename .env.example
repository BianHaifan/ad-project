# Safe local-development examples only. Copy to your own untracked environment file.
DB_URL=jdbc:mysql://localhost:3306/adproject?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=adproject
DB_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
SERVER_PORT=8080
# Recruiter Google OAuth connection (Google Meet slice). Placeholders only — never commit real values.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-deployed-host/api/v1/recruiter/google-oauth/callback
# Fixed recruiter Web page used after the backend OAuth callback; replace with the exact active Web origin.
GOOGLE_OAUTH_WEB_RETURN_URI=http://localhost:5173/recruiter/google-oauth
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
